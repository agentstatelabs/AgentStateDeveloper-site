<script>
(function() {
  'use strict';
  // Reveal on scroll
  var els = document.querySelectorAll('[data-reveal]');
  if (els.length && 'IntersectionObserver' in window) {
    var obs = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) { if (e.isIntersecting) { e.target.classList.add('revealed'); obs.unobserve(e.target); } });
    }, { threshold: 0.12 });
    els.forEach(function(el) { obs.observe(el); });
  } else {
    els.forEach(function(el) { el.classList.add('revealed'); });
  }

  // Install tabs
  var tabs = document.querySelectorAll('.tab');
  var cmdEl = document.getElementById('install-cmd');
  tabs.forEach(function(t) {
    t.addEventListener('click', function() {
      tabs.forEach(function(x) { x.classList.remove('active'); });
      t.classList.add('active');
      if (cmdEl) cmdEl.textContent = t.getAttribute('data-cmd');
    });
  });

  // Copy helpers
  function copy(text, el, label) {
    if (navigator.clipboard) { navigator.clipboard.writeText(text).catch(function(){}); }
    if (el) { var o = el.textContent; el.textContent = label || 'COPIED'; setTimeout(function(){ el.textContent = o; }, 1400); }
  }
  var copyCmd = document.getElementById('copy-cmd');
  if (copyCmd) copyCmd.addEventListener('click', function() { copy(cmdEl.textContent, copyCmd, 'COPIED'); });
  var copyPrompt = document.getElementById('copy-prompt');
  if (copyPrompt) copyPrompt.addEventListener('click', function() {
    var p = document.getElementById('agent-prompt');
    copy(p ? p.innerText : '', copyPrompt, 'COPIED');
  });
})();
</script>
