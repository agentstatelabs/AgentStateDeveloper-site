---
// Shared marketing layout — nav, footer, design system.
// Structure modeled on ctxone.com; ASD purple color scheme retained.
const {
  title = 'AgentStateDeveloper — Code-level context and audit overlay for agent-authored code',
  description = 'Decision ledger, effect declarations, and call graph for every function — queryable by agents over MCP, checked into git.',
  active = '',
  url = 'https://agentstatedeveloper.dev',
} = Astro.props;
const year = new Date().getFullYear();
const nav = [
  { label: 'Why ASD', href: '/why/', key: 'why' },
  { label: 'Docs', href: '/guides/introduction/', key: 'docs' },
  { label: 'Use cases', href: '/use-cases/', key: 'use-cases' },
  { label: 'Blog', href: '/blog/', key: 'blog' },
  // Withheld until the Team & Enterprise tiers ship:
  // { label: 'Team & Enterprise', href: '/#editions', key: 'editions' },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <link rel="icon" href="/favicon.svg" />
  <style is:global>
    :root {
      --accent: #8b5cf6;
      --accent-bright: #a78bfa;
      --accent-glow: #8b5cf633;
      --accent-subtle: #8b5cf618;
      --cyan: #a78bfa;
      --bg-primary: #0a0a14;
      --bg-secondary: #14101f;
      --bg-tertiary: #1f1a2e;
      --border: #2a2140;
      --border-strong: #3a2d5c;
      --text-primary: #e8e6f0;
      --text-secondary: #9b93b3;
      --text-muted: #6b6485;
      --success: #00ff88;
      --warning: #f59e0b;
      --radius: 12px;
      --radius-sm: 8px;
      --mono: 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace;
      --maxw: 1120px;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: var(--bg-primary); color: var(--text-primary); line-height: 1.6; overflow-x: hidden; -webkit-font-smoothing: antialiased; }
    a { color: var(--accent-bright); text-decoration: none; }
    a:hover { filter: brightness(1.15); }
    code { font-family: var(--mono); font-size: 0.9em; }
    .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 24px; }
    .eyebrow { font-family: var(--mono); font-size: 11px; letter-spacing: 1.1px; text-transform: uppercase; color: var(--text-muted); font-weight: 600; }
    .eyebrow .dot { color: var(--accent); }

    /* Nav — sizing matched to ctxone.com (14.4px / 500 / system) */
    .nav { position: sticky; top: 0; z-index: 100; height: 60px; display: flex; align-items: center; background: rgba(10,10,20,0.72); backdrop-filter: blur(14px); border-bottom: 1px solid var(--border); }
    .nav-inner { display: flex; align-items: center; justify-content: space-between; max-width: var(--maxw); width: 100%; margin: 0 auto; padding: 0 24px; }
    .nav-logo { display: flex; align-items: center; gap: 9px; font-size: 16px; font-weight: 700; color: var(--text-primary); }
    .nav-logo .glyph { width: 15px; height: 15px; border-radius: 4px; background: linear-gradient(135deg, #6d28d9, #a78bfa); box-shadow: 0 0 12px var(--accent-glow); }
    .nav-links { display: flex; align-items: center; gap: 26px; }
    .nav-links a { color: var(--text-secondary); font-size: 14.4px; font-weight: 500; letter-spacing: normal; transition: color 0.2s; }
    .nav-links a:hover, .nav-links a.active { color: var(--text-primary); filter: none; }
    .nav-gh { border: 1px solid var(--border-strong); border-radius: var(--radius-sm); padding: 7px 14px !important; color: var(--text-primary) !important; }
    .nav-gh:hover { border-color: var(--accent); }
    @media (max-width: 860px) { .nav-links a:not(.nav-gh) { display: none; } }

    /* Buttons */
    .btn { display: inline-flex; align-items: center; gap: 8px; padding: 12px 22px; border-radius: var(--radius-sm); font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.2s; border: 1px solid transparent; }
    .btn-primary { background: var(--accent); color: #fff; }
    .btn-primary:hover { filter: brightness(1.12); transform: translateY(-1px); box-shadow: 0 6px 20px var(--accent-glow); }
    .btn-secondary { background: transparent; color: var(--text-primary); border-color: var(--border-strong); }
    .btn-secondary:hover { border-color: var(--accent); color: var(--accent-bright); }

    /* Hero */
    .hero { position: relative; padding: 88px 0 72px; overflow: hidden; }
    .hero::before { content: ''; position: absolute; inset: 0; z-index: 0; background: radial-gradient(ellipse 60% 50% at 20% 0%, rgba(139,92,246,0.18), transparent 65%), radial-gradient(ellipse 50% 40% at 85% 10%, rgba(109,40,217,0.12), transparent 60%); }
    .hero .wrap { position: relative; z-index: 1; }
    .hero h1 { font-size: 60px; line-height: 1.05; font-weight: 800; letter-spacing: -1.5px; margin: 22px 0 24px; max-width: 820px; text-wrap: balance; }
    .hero h1 .accent { color: var(--accent-bright); }
    .hero .lead { font-size: 21px; color: var(--text-primary); max-width: 660px; line-height: 1.6; margin-bottom: 16px; }
    .hero .lead strong { font-weight: 700; }
    .hero .sub { font-size: 16px; color: var(--text-secondary); max-width: 660px; line-height: 1.65; margin-bottom: 32px; }
    .hero .sub .kw { color: var(--text-primary); font-weight: 600; }
    .hero .sub .kw.warn { color: var(--text-primary); font-weight: 600; }

    /* Page hero (secondary pages) */
    .page-hero { position: relative; padding: 72px 0 40px; overflow: hidden; }
    .page-hero::before { content: ''; position: absolute; inset: 0; z-index: 0; background: radial-gradient(ellipse 60% 60% at 20% 0%, rgba(139,92,246,0.14), transparent 65%); }
    .page-hero .wrap { position: relative; z-index: 1; }
    .page-hero h1 { font-size: 48px; line-height: 1.05; font-weight: 800; letter-spacing: -1.3px; margin: 16px 0 18px; max-width: 780px; text-wrap: balance; }
    .page-hero .lead { font-size: 21px; color: var(--text-secondary); max-width: 680px; line-height: 1.6; }
    .page-hero .lead strong { color: var(--text-primary); font-weight: 600; }

    /* Install card */
    .install { background: linear-gradient(180deg, var(--bg-secondary), var(--bg-primary)); border: 1px solid var(--border-strong); border-radius: var(--radius); padding: 20px; max-width: 720px; box-shadow: 0 8px 40px rgba(0,0,0,0.35); }
    .install-head { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
    .install-head .bolt { font-size: 16px; }
    .install-head .t { font-weight: 700; font-size: 15px; }
    .install-head .spacer { flex: 1; }
    .install-head .mini { font-family: var(--mono); font-size: 10px; letter-spacing: 1px; color: var(--text-muted); border: 1px solid var(--border); border-radius: 5px; padding: 4px 9px; cursor: pointer; transition: all 0.2s; }
    .install-head .mini:hover { border-color: var(--accent); color: var(--accent-bright); }
    .install pre { background: var(--bg-primary); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 14px; font-family: var(--mono); font-size: 12.5px; line-height: 1.7; color: var(--text-secondary); overflow-x: auto; white-space: pre-wrap; }
    .install pre .c { color: var(--accent-bright); }
    .install-or { font-family: var(--mono); font-size: 10px; letter-spacing: 1.5px; color: var(--text-muted); margin: 18px 0 10px; }
    .tabs { display: flex; gap: 6px; margin-bottom: 10px; flex-wrap: wrap; }
    .tab { font-size: 12px; font-weight: 600; padding: 7px 13px; border-radius: 6px; border: 1px solid var(--border); color: var(--text-secondary); cursor: pointer; transition: all 0.2s; background: transparent; }
    .tab .os { display: block; font-size: 9px; font-weight: 500; color: var(--text-muted); margin-top: 1px; }
    .tab.active { border-color: var(--accent); color: var(--accent-bright); background: var(--accent-subtle); }
    .cmd-row { display: flex; align-items: center; gap: 10px; background: var(--bg-primary); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 11px 14px; }
    .cmd-row .dollar { color: var(--accent); font-family: var(--mono); }
    .cmd-row code { flex: 1; color: var(--text-primary); font-size: 12.5px; overflow-x: auto; white-space: nowrap; }
    .cmd-row .copy { font-family: var(--mono); font-size: 10px; letter-spacing: 1px; color: var(--text-muted); cursor: pointer; }
    .cmd-row .copy:hover { color: var(--accent-bright); }

    .runs-on { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 14px; font-size: 11px; color: var(--text-muted); }
    .chip { font-size: 11px; padding: 4px 10px; border-radius: 20px; border: 1px solid var(--border); color: var(--text-secondary); }

    .hero-cta { display: flex; gap: 12px; margin-top: 28px; flex-wrap: wrap; }
    .feat-row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 28px; }
    .feat { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; color: var(--text-secondary); }
    .feat::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: var(--accent); }

    /* Stat band — contained card with inset dividers + glow */
    .stats { padding: 20px 0 8px; }
    .stats-card { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--border); border-radius: 16px; background: linear-gradient(180deg, rgba(20,16,31,0.55), rgba(10,10,20,0.25)); overflow: hidden; }
    .stat { padding: 38px 24px; text-align: center; position: relative; }
    .stat + .stat::before { content: ''; position: absolute; left: 0; top: 24px; bottom: 24px; width: 1px; background: var(--border); }
    .stat .n { font-size: 42px; font-weight: 800; color: #c4b5fd; letter-spacing: -0.8px; line-height: 1; text-shadow: 0 0 22px rgba(139,92,246,0.18); }
    .stat .l { font-family: var(--mono); font-size: 11px; letter-spacing: 2px; color: var(--text-muted); text-transform: uppercase; margin-top: 10px; }
    @media (max-width: 720px) { .stats-card { grid-template-columns: repeat(2, 1fr); } .stat:nth-child(3)::before, .stat:nth-child(2) + .stat::before { display: none; } .stat:nth-child(3), .stat:nth-child(4) { border-top: 1px solid var(--border); } }

    /* Sections */
    .section { padding: 84px 0; }
    .section.tight { padding: 56px 0; }
    .section.alt { background: var(--bg-secondary); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
    .section-head { max-width: 720px; margin-bottom: 44px; }
    .section-head.center { margin-left: auto; margin-right: auto; text-align: center; }
    .section-head h2 { font-size: 27px; font-weight: 700; letter-spacing: -0.4px; margin-top: 10px; }
    .section-head p { font-size: 16px; color: var(--text-secondary); margin-top: 12px; line-height: 1.65; }

    /* Card grid (architecture / capabilities) */
    .card-grid { display: grid; gap: 16px; }
    .card-grid.cols-3 { grid-template-columns: repeat(3, 1fr); }
    .card-grid.cols-2 { grid-template-columns: repeat(2, 1fr); }
    .card { --c: var(--accent-bright); background: var(--bg-secondary); border: 1px solid var(--border); border-radius: var(--radius); padding: 22px; transition: border-color 0.2s, transform 0.2s; position: relative; overflow: hidden; }
    .card::before { content: ''; position: absolute; top: 0; left: 0; width: 3px; height: 0; background: var(--c); transition: height 0.25s ease; }
    .card:hover { border-color: color-mix(in srgb, var(--c) 55%, var(--border)); transform: translateY(-2px); }
    .card:hover::before { height: 100%; }
    /* Per-card accent colors — break up the uniform purple */
    .card.c-purple { --c: #a78bfa; }
    .card.c-green  { --c: #34d399; }
    .card.c-amber  { --c: #f5a524; }
    .card.c-blue   { --c: #38bdf8; }
    .card.c-pink   { --c: #f472b6; }
    .card.c-cyan   { --c: #22d3ee; }
    .card .slug { font-family: var(--mono); font-size: 12px; color: var(--c); margin-bottom: 12px; }
    .card h3 { font-size: 18px; font-weight: 700; margin-bottom: 8px; }
    .card p { font-size: 14px; color: var(--text-secondary); line-height: 1.6; }
    .card p + p { margin-top: 10px; }
    .card pre { margin-top: 14px; background: var(--bg-primary); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 12px; font-family: var(--mono); font-size: 11.5px; line-height: 1.7; color: var(--text-secondary); overflow-x: auto; }
    .card pre .p { color: var(--c); }
    @media (max-width: 900px) { .card-grid.cols-3 { grid-template-columns: 1fr; } .card-grid.cols-2 { grid-template-columns: 1fr; } }

    /* Numbered pillars (moments) */
    .pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .pillar { --c: var(--accent-bright); background: var(--bg-secondary); border: 1px solid var(--border); border-radius: var(--radius); padding: 26px; position: relative; overflow: hidden; transition: border-color 0.2s, transform 0.2s; }
    .pillar::before { content: ''; position: absolute; top: 0; left: 0; width: 3px; height: 0; background: var(--c); transition: height 0.25s ease; }
    .pillar:hover { border-color: color-mix(in srgb, var(--c) 55%, var(--border)); transform: translateY(-2px); }
    .pillar:hover::before { height: 100%; }
    .pillar.c-purple { --c: #a78bfa; }
    .pillar.c-green  { --c: #34d399; }
    .pillar.c-amber  { --c: #f5a524; }
    .pillar.c-blue   { --c: #38bdf8; }
    .pillar.c-pink   { --c: #f472b6; }
    .pillar.c-cyan   { --c: #22d3ee; }
    .pillar .num { font-family: var(--mono); font-size: 12px; letter-spacing: 1px; color: var(--c); margin-bottom: 14px; }
    .pillar h3 { font-size: 19px; font-weight: 700; margin-bottom: 10px; }
    .pillar p { font-size: 14px; color: var(--text-secondary); line-height: 1.65; margin-bottom: 12px; }
    .pillar .answer { font-size: 14px; color: var(--text-primary); line-height: 1.6; }
    .pillar .answer strong { color: var(--c); }
    .pillar code { color: var(--c); }
    @media (max-width: 900px) { .pillars { grid-template-columns: 1fr; } }

    /* Mockups (reused for the moments) */
    .mockup { background: var(--bg-secondary); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px; }
    .mockup-header { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid var(--border); }
    .mockup-header .title { font-family: var(--mono); font-size: 12px; font-weight: 600; color: var(--text-primary); }
    .mockup-header .badge-sm { font-size: 9px; color: var(--accent-bright); background: var(--accent-subtle); padding: 2px 7px; border-radius: 10px; margin-left: auto; letter-spacing: 0.5px; }
    .blame-output { font-family: var(--mono); font-size: 11px; line-height: 1.85; }
    .blame-output .label { color: var(--text-muted); }
    .blame-output .value { color: var(--text-primary); }
    .blame-output .agent { color: var(--accent-bright); }
    .blame-output .time { color: var(--cyan); }
    .blame-output .reason { color: var(--warning); font-style: italic; }
    .moment { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; margin-bottom: 28px; }
    .moment:nth-child(even) .moment-text { order: 2; }
    @media (max-width: 880px) { .moment { grid-template-columns: 1fr; gap: 20px; } .moment:nth-child(even) .moment-text { order: 0; } }

    /* Pairs-with */
    .pairs { display: grid; grid-template-columns: 1.3fr 1fr; gap: 40px; align-items: center; background: var(--bg-secondary); border: 1px solid var(--border); border-radius: var(--radius); padding: 36px; }
    .pairs h2 { font-size: 27px; font-weight: 700; letter-spacing: -0.4px; margin: 10px 0 14px; }
    .pairs p { color: var(--text-secondary); line-height: 1.65; margin-bottom: 12px; }
    .pairs .integ { background: var(--bg-primary); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 18px; }
    .pairs .integ .row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px dashed var(--border); font-size: 13px; }
    .pairs .integ .row:last-child { border-bottom: none; }
    .pairs .integ .row .k { font-family: var(--mono); color: var(--accent-bright); }
    .pairs .integ .row .v { color: var(--text-muted); font-size: 12px; }
    @media (max-width: 880px) { .pairs { grid-template-columns: 1fr; padding: 26px; } }

    /* Editions — matched to ctxone.com: per-tier color, larger type, button CTAs */
    .editions { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; align-items: stretch; }
    .edition { --tier: var(--accent-bright); --tier-soft: rgba(167,139,250,0.12); position: relative; background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 14px; padding: 32px 28px; display: flex; flex-direction: column; }
    .edition.oss { --tier: #34d399; --tier-soft: rgba(52,211,153,0.12); }
    .edition.team { --tier: var(--accent-bright); --tier-soft: rgba(167,139,250,0.14); }
    .edition.enterprise { --tier: #f5a524; --tier-soft: rgba(245,165,36,0.12); }
    .edition.featured { border-color: var(--tier); box-shadow: 0 0 0 1px var(--tier-soft), 0 12px 40px var(--tier-soft); }
    .edition .flag { position: absolute; top: -12px; left: 28px; font-family: var(--mono); font-size: 9.5px; letter-spacing: 1.5px; text-transform: uppercase; font-weight: 700; color: #0a0a14; background: var(--tier); padding: 5px 11px; border-radius: 20px; }
    .edition .tier { font-size: 30px; font-weight: 800; letter-spacing: -0.8px; color: var(--text-primary); line-height: 1; }
    .edition .price { font-family: var(--mono); font-size: 15px; font-weight: 600; color: var(--tier); margin: 12px 0 16px; }
    .edition .desc { font-size: 15px; color: var(--text-secondary); line-height: 1.6; margin-bottom: 20px; padding-bottom: 20px; border-bottom: 1px solid var(--border); }
    .edition ul { list-style: none; display: flex; flex-direction: column; gap: 13px; margin-bottom: 26px; }
    .edition li { font-size: 15px; color: var(--text-secondary); display: flex; gap: 11px; line-height: 1.5; }
    .edition li::before { content: '→'; color: var(--tier); font-weight: 700; flex-shrink: 0; }
    .edition .cta { margin-top: auto; font-weight: 700; font-size: 15px; color: var(--tier); border: 1px solid var(--tier); border-radius: var(--radius-sm); padding: 13px 18px; display: flex; align-items: center; justify-content: center; gap: 8px; transition: all 0.2s; }
    .edition .cta:hover { background: var(--tier-soft); filter: none; }
    .edition.featured .cta { background: var(--tier); color: #0a0a14; }
    .edition.featured .cta:hover { background: var(--tier); filter: brightness(1.1); }
    @media (max-width: 900px) { .editions { grid-template-columns: 1fr; } }

    /* Prose (content pages) */
    .prose { max-width: 760px; }
    .prose h2 { font-size: 26px; font-weight: 800; letter-spacing: -0.5px; margin: 44px 0 14px; }
    .prose h2:first-child { margin-top: 0; }
    .prose h3 { font-size: 18px; font-weight: 700; margin: 28px 0 8px; color: var(--text-primary); }
    .prose p { font-size: 16px; color: var(--text-secondary); line-height: 1.75; margin-bottom: 16px; }
    .prose p strong { color: var(--text-primary); font-weight: 600; }
    .prose ul { margin: 0 0 18px; padding-left: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; }
    .prose ul li { position: relative; padding-left: 22px; font-size: 15.5px; color: var(--text-secondary); line-height: 1.6; }
    .prose ul li::before { content: '→'; position: absolute; left: 0; color: var(--accent); }
    .prose code { color: var(--accent-bright); background: var(--accent-subtle); padding: 1px 5px; border-radius: 4px; }
    .prose blockquote { border-left: 3px solid var(--accent); padding: 4px 0 4px 18px; margin: 0 0 18px; color: var(--text-primary); font-size: 17px; line-height: 1.6; }

    /* Blog list — CTXone-style rows */
    .blog-list { display: flex; flex-direction: column; max-width: 820px; }
    .post { --c: var(--accent-bright); display: block; padding: 26px 0; border-bottom: 1px solid var(--border); transition: none; }
    .post:hover { filter: none; }
    .post .meta { font-family: var(--mono); font-size: 12px; letter-spacing: 0.5px; color: var(--text-muted); margin-bottom: 10px; }
    .post .meta .dot { color: var(--c); }
    .post h3 { font-size: 24px; font-weight: 800; letter-spacing: -0.5px; color: var(--text-primary); margin-bottom: 8px; transition: color 0.2s; }
    .post:hover h3 { color: var(--c); }
    .post p { font-size: 15px; color: var(--text-secondary); line-height: 1.65; max-width: 680px; }
    .post .more { display: inline-block; margin-top: 10px; font-size: 14px; font-weight: 600; color: var(--c); }
    .post.c-purple { --c: #a78bfa; } .post.c-green { --c: #34d399; } .post.c-amber { --c: #f5a524; }
    .post.c-blue { --c: #38bdf8; } .post.c-pink { --c: #f472b6; } .post.c-cyan { --c: #22d3ee; }
    .empty-note { background: var(--bg-secondary); border: 1px dashed var(--border-strong); border-radius: var(--radius); padding: 32px; text-align: center; color: var(--text-secondary); max-width: 640px; }
    .empty-note .big { font-size: 17px; color: var(--text-primary); font-weight: 600; margin-bottom: 8px; }

    /* Article page */
    .article { max-width: 720px; }
    .article .a-meta { font-family: var(--mono); font-size: 12px; letter-spacing: 0.5px; color: var(--text-muted); margin-bottom: 14px; }
    .article .a-meta .dot { color: var(--c, var(--accent-bright)); }
    .article h1 { font-size: 42px; font-weight: 800; letter-spacing: -1.4px; line-height: 1.06; margin-bottom: 16px; text-wrap: balance; }
    .article .a-lead { font-size: 19px; color: var(--text-secondary); line-height: 1.6; margin-bottom: 8px; }
    .article .a-rule { height: 3px; width: 56px; background: var(--c, var(--accent-bright)); border-radius: 2px; margin: 24px 0 8px; }
    .a-body { margin-top: 28px; }
    .a-body h2 { font-size: 25px; font-weight: 800; letter-spacing: -0.4px; margin: 40px 0 12px; }
    .a-body h3 { font-size: 18px; font-weight: 700; margin: 28px 0 8px; }
    .a-body p { font-size: 16.5px; color: var(--text-secondary); line-height: 1.75; margin-bottom: 18px; }
    .a-body p strong { color: var(--text-primary); font-weight: 600; }
    .a-body em { color: var(--text-primary); font-style: italic; }
    .a-body a { color: var(--c, var(--accent-bright)); }
    .a-body ul { margin: 0 0 20px; padding-left: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; }
    .a-body ul li { position: relative; padding-left: 22px; font-size: 16px; color: var(--text-secondary); line-height: 1.6; }
    .a-body ul li::before { content: '→'; position: absolute; left: 0; color: var(--c, var(--accent-bright)); }
    .a-body :not(pre) > code { color: var(--c, var(--accent-bright)); background: color-mix(in srgb, var(--c, var(--accent-bright)) 12%, transparent); padding: 1px 5px; border-radius: 4px; font-size: 0.88em; }
    .a-body pre { background: var(--bg-secondary); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 16px; overflow-x: auto; margin-bottom: 20px; font-size: 13.5px; line-height: 1.6; }
    .a-body pre code { color: var(--text-primary); }
    .a-body > p:last-child { margin-top: 32px; padding-top: 20px; border-top: 1px solid var(--border); color: var(--text-muted); font-size: 15px; }
    .a-body > p:last-child em { color: var(--text-muted); }
    .a-back { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; color: var(--text-secondary); margin-bottom: 28px; }
    .a-back:hover { color: var(--c, var(--accent-bright)); filter: none; }

    /* Footer */
    .footer { background: var(--bg-secondary); border-top: 1px solid var(--border); padding: 52px 0 28px; }
    .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 32px; max-width: var(--maxw); margin: 0 auto 32px; padding: 0 24px; }
    .footer-brand .nav-logo { margin-bottom: 12px; }
    .footer-brand p { font-size: 13px; color: var(--text-muted); line-height: 1.6; max-width: 260px; }
    .footer-col h4 { font-size: 12px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 14px; }
    .footer-col a { display: block; color: var(--text-secondary); font-size: 13px; padding: 4px 0; }
    .footer-col a:hover { color: var(--accent-bright); filter: none; }
    .footer-bottom { text-align: center; font-size: 12px; color: var(--text-muted); padding-top: 24px; border-top: 1px solid var(--border); max-width: var(--maxw); margin: 0 auto; }
    @media (max-width: 720px) { .footer-grid { grid-template-columns: 1fr 1fr; } }

    [data-reveal] { opacity: 0; transform: translateY(28px); transition: opacity 0.6s cubic-bezier(0.25,0.46,0.45,0.94), transform 0.6s cubic-bezier(0.25,0.46,0.45,0.94); }
    [data-reveal].revealed { opacity: 1; transform: none; }

    @media (max-width: 640px) {
      .hero h1 { font-size: 38px; }
      .page-hero h1 { font-size: 32px; }
      .hero { padding: 56px 0 48px; }
      .section { padding: 60px 0; }
      .section-head h2 { font-size: 26px; }
      .stat .n { font-size: 32px; }
    }
  </style>
</head>
<body>

<nav class="nav">
  <div class="nav-inner">
    <a class="nav-logo" href="/"><span class="glyph"></span>AgentStateDeveloper</a>
    <div class="nav-links">
      {nav.map((n) => (
        <a href={n.href} class={active === n.key ? 'active' : ''}>{n.label}</a>
      ))}
      <a class="nav-gh" href="https://github.com/agentstatelabs/AgentStateDeveloper" target="_blank">GitHub</a>
    </div>
  </div>
</nav>

<slot />

<footer class="footer">
  <div class="footer-grid">
    <div class="footer-brand">
      <span class="nav-logo"><span class="glyph"></span>AgentStateDeveloper</span>
      <p>Code-level context and audit overlay for agent-authored code. Rust core, 9 languages, 64 MCP tools, git-native sidecar.</p>
    </div>
    <div class="footer-col">
      <h4>Product</h4>
      <a href="/why/">Why ASD</a>
      <a href="/use-cases/">Use cases</a>
      <a href="/guides/quickstart/">Quick Start</a>
